# Reverse proxy of the public demo (compose.prod.yml). Caddy gets and renews the Let's Encrypt certificate by itself.
# Only this container publishes ports (80, 443); api, worker, postgres, s3 and asr stay on the compose network.
{
	# HTTP/3 would need UDP 443, which we do not publish.
	servers {
		protocols h1 h2
	}
}

# Two names for the same site: people type the IP with dots or with dashes (sslip.io resolves both), and a name Caddy has no
# site for gets a TLS "internal error" alert (browser: ERR_SSL_PROTOCOL_ERROR). Each name gets its own certificate.
{$PUBLIC_HOST}, {$PUBLIC_HOST_ALT} {
	# No `log` directive on purpose: Caddy's access log would write the query string of presigned download links
	# (X-Amz-Signature) to disk. Errors still go to stderr.

	# Download links are presigned S3 URLs on this same host: /<bucket>/<key>?X-Amz-...
	# Why no path prefix like /files/: the signature covers the path, so rewriting it would invalidate it.
	# Only GET/HEAD reach storage; uploads and deletes never go through the public door.
	@storage path /{$S3_BUCKET:incubrix}/*
	handle @storage {
		@read method GET HEAD
		handle @read {
			reverse_proxy s3:8333
		}
		handle {
			respond "Method not allowed" 405
		}
	}

	# Session pack: read-only download of the final outputs (videos, results.json, timelines), behind basic auth.
	# Why Caddy and not the API: these are plain files on the VM, they must not depend on the API token, and storage retention
	# (apps/worker/src/retention.ts) only looks at S3 keys under renders/ and videos/, so these files are never swept.
	# Why only GET/HEAD: file_server would answer other methods with the file too.
	handle_path /pack/* {
		@pack_write not method GET HEAD
		respond @pack_write "Method not allowed" 405
		basic_auth {
			{$PACK_USER} {$PACK_PASSWORD_HASH}
		}
		root * /srv/pack
		file_server browse
	}

	handle {
		# Upload cap at the door, so an oversized body is not streamed to the API. The API enforces the same MAX_UPLOAD_MB.
		# 1) A request that DECLARES a size above the cap is answered at once, before any body is read, with the JSON
		#    FILE_TOO_LARGE error. (Why: if the body is cut off mid-upload, a client that is still writing can see a connection
		#    reset instead of the 413; reproduced with Node's fetch, docs/raw/m5d_upload_before.txt, 1 run in 6.)
		#    `size(h) > 0 &&` first: a request without Content-Length (chunked) must not reach int("").
		@declared_too_large expression `size({http.request.header.Content-Length}) > 0 && int({http.request.header.Content-Length}) > {$MAX_UPLOAD_MB:2048} * 1048576`
		handle @declared_too_large {
			header Content-Type application/json
			respond `{"error":{"code":"FILE_TOO_LARGE","message":"The request is larger than the upload limit of this deployment.","retryable":false,"details":{}}}` 413
		}
		# 2) For bodies that lie or are chunked: cut at the cap. MiB (not MB): Caddy's "MB" is 1,000,000 bytes, the API's cap is
		#    MAX_UPLOAD_MB * 1024 * 1024; with "MB" the two disagreed (200 MB cap vs a 200,422,585-byte file).
		request_body {
			max_size {$MAX_UPLOAD_MB:2048}MiB
		}
		# No read/write timeout is set on the server: a 2 GB upload on a slow line must not be cut. (Caddy has none by default.)
		reverse_proxy api:8080
	}

	# Keep the error contract (JSON, UPPER_SNAKE_CASE code) for what Caddy itself rejects.
	handle_errors {
		@toolarge `{err.status_code} == 413`
		handle @toolarge {
			header Content-Type application/json
			respond `{"error":{"code":"FILE_TOO_LARGE","message":"The request is larger than the upload limit of this deployment.","retryable":false,"details":{}}}` 413
		}
		@bad `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
		handle @bad {
			header Content-Type application/json
			respond `{"error":{"code":"SERVICE_UNAVAILABLE","message":"The service is starting or restarting. Try again in a few seconds.","retryable":true,"details":{}}}` 503
		}
	}
}
