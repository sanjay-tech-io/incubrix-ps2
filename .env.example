# Every setting the services read. Copy to .env to override; docker compose loads
# this file first and then .env (if present). Values below are DEV-ONLY defaults,
# never use them outside a local machine. Leaving a value blank means "use the default".
# packages/config validates all of this at startup and refuses to start on a bad value.

NODE_ENV=development
LOG_LEVEL=info
PORT=8080

# Postgres 16 (plain SQL migrations). A hosted Postgres URL may be used for the demo only.
DATABASE_URL=postgres://incubrix:incubrix-dev@postgres:5432/incubrix
POSTGRES_USER=incubrix
POSTGRES_PASSWORD=incubrix-dev
POSTGRES_DB=incubrix

# S3-compatible store (SeaweedFS in compose, see docs/REVIEW_INFRA.md for why not MinIO)
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=incubrix
S3_ACCESS_KEY=incubrix-dev-access
S3_SECRET_KEY=incubrix-dev-secret-key
S3_FORCE_PATH_STYLE=true

# Providers: the real ones are the default (the demo needs them); tests set mock explicitly.
# The ASR service reads ASR_PROVIDER and DIARIZATION_PROVIDER too, so there is one switch.
ASR_PROVIDER=faster-whisper
ASR_URL=http://asr:8000
ASR_MODEL=base.en
ASR_TIMEOUT_S=3600
DIARIZATION_PROVIDER=sherpa
LLM_PROVIDER=rules
LLM_TIMEOUT_MS=1500
# Required only when LLM_PROVIDER=groq / gemini
GROQ_API_KEY=
GEMINI_API_KEY=

# Speed range: min 0.25x is fixed, max is configurable (1..16)
MAX_SPEED=4
# Signs job callbacks (X-IncuBrix-Signature). At least 16 characters when set.
CALLBACK_HMAC_SECRET=

# API / worker
# Bearer token for the API (not /health, /ready). Blank = open API, for local development only.
API_TOKEN=
RATE_LIMIT_PER_MIN=120
MAX_UPLOAD_MB=2048
# Tests only: allow video URLs that point to private/loopback addresses
URL_ALLOW_PRIVATE=false
JOB_STALE_S=300
WORKER_POLL_MS=500
WORKER_PORT=8081
# Host:port clients can reach, used in presigned download links (compose publishes 8333). Blank = S3_ENDPOINT. Change it for a deployment.
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Silence detection / word clamping (part of the transcript cache key)
SILENCE_NOISE_DB=-35
SILENCE_MIN_MS=300
CLAMP_MIN_WORD_MS=20
LOW_CONFIDENCE_PERMILLE=600
# Untranscribed voiced stretches in gaps between words (possible fillers): kept when this long (ms)
VOICED_GAP_MIN_MS=150
VOICED_GAP_MAX_MS=1200

# Render (ffmpeg, H.264 + AAC MP4, yuv420p, +faststart)
RENDER_PRESET=veryfast
RENDER_CRF=20
# 0 = keep the source height; otherwise scale down (never up) to at most this height
RENDER_MAX_HEIGHT=0
# Pieces per seeked input pair (0 = one group over the whole file). 30 was fastest in the 1080p bench.
RENDER_GROUP_PIECES=30
RENDER_MAX_GROUPS=64
RENDER_TMP_DIR=/tmp
# Renders and CFR proxies older than this many days are deleted (originals are kept); 0 = keep everything
RETENTION_DAYS=14
# Services refuse to start with less free disk than this (GB) in their temp folder
MIN_FREE_DISK_GB=3
# SeaweedFS master, called after a cleanup so the disk space is really freed (blank = skip)
S3_VACUUM_URL=http://s3:9333/vol/vacuum?garbageThreshold=0.1

# services/asr (read by the Python service, not by the Node config loader)
# The ASR provider itself is ASR_PROVIDER above (mock = fixture transcript, faster-whisper = real model).
# Models are downloaded into /models (base.en is baked into the image at build time; any other
# ASR_MODEL downloads on first use and is kept if /models is a volume). small.en vs base.en is NOT
# proven on real speech yet (docs/SPIKE_ASR.md).
WHISPER_COMPUTE_TYPE=int8
WHISPER_INITIAL_PROMPT=

# Diarization (services/asr). DIARIZATION_PROVIDER above is shared with the Node config:
# sherpa = real (sherpa-onnx + pyannote-3.0 segmentation + WeSpeaker), mock = fixed turns, none = off.
DIARIZATION_MODEL_DIR=/models/diarization
# -1 = clustering decides. sherpa-onnx has no min/max speaker setting, only a fixed count or a threshold.
DIARIZATION_NUM_SPEAKERS=-1
DIARIZATION_CLUSTER_THRESHOLD=0.5
# Word flagged speaker_uncertain when its best speaker covers less than this fraction of it
DIARIZATION_UNCERTAIN_BELOW=0.6
# Word flagged overlaps_speech when a second speaker covers at least this fraction of it
DIARIZATION_OVERLAP_MIN_FRACTION=0.2
