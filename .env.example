# Every setting the services read. Copy to .env to override; docker compose loads
# this file first and then .env (if present). Values below are DEV-ONLY defaults,
# never use them outside a local machine. Leaving a value blank means "use the default".
# packages/config validates all of this at startup and refuses to start on a bad value.

NODE_ENV=development
LOG_LEVEL=info
PORT=8080

# Postgres 16 (plain SQL migrations). A hosted Postgres URL may be used for the demo only.
DATABASE_URL=postgres://incubrix:incubrix-dev@postgres:5432/incubrix
POSTGRES_USER=incubrix
POSTGRES_PASSWORD=incubrix-dev
POSTGRES_DB=incubrix

# S3-compatible store (SeaweedFS in compose, see docs/REVIEW_INFRA.md for why not MinIO)
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=incubrix
S3_ACCESS_KEY=incubrix-dev-access
S3_SECRET_KEY=incubrix-dev-secret-key
S3_FORCE_PATH_STYLE=true

# Providers: mock is for tests; the real demo uses faster-whisper.
ASR_PROVIDER=mock
ASR_URL=http://asr:8000
DIARIZATION_PROVIDER=mock
LLM_PROVIDER=rules
LLM_TIMEOUT_MS=1500
# Required only when LLM_PROVIDER=groq / gemini
GROQ_API_KEY=
GEMINI_API_KEY=

# Speed range: min 0.25x is fixed, max is configurable (1..16)
MAX_SPEED=4
# Signs job callbacks (X-IncuBrix-Signature). At least 16 characters when set.
CALLBACK_HMAC_SECRET=

# services/asr (read by the Python service, not by the Node config loader)
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_INITIAL_PROMPT=
